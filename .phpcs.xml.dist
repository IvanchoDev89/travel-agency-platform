<?xml version="1.0"?>
<ruleset name="Travel Agency Platform">
	<description>
		PHP_CodeSniffer rules for the Travel Agency Platform plugin.

		Based on the WordPress Coding Standards, but the purely cosmetic sniffs
		that conflict with the project's established style are excluded so the
		report stays focused on correctness, security, database and i18n issues:

		- 4-space indentation (not WP tabs) and droppped spacing inside
		  parentheses / brackets.
		- Short array syntax ([]), single-line associative arrays and the
		  project's own alignment.
		- Custom $wpdb tables (DirectDatabaseQuery) are intentional; they are
		  audited separately in tests rather than via this smell.

		Formatting can still be inspected ad-hoc with:
		  vendor/bin/phpcs --standard=WordPress &lt;file&gt;
	</description>

	<file>app/public/wp-content/plugins/travel-agency-platform</file>

	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/languages/*</exclude-pattern>
	<exclude-pattern>*/assets/leaflet/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>
	<arg name="basepath" value="."/>

	<rule ref="WordPress">
		<!-- Cosmetic: indentation / whitespace / spacing. -->
		<exclude name="Generic.WhiteSpace.DisallowSpaceIndent"/>
		<exclude name="Generic.WhiteSpace.ArbitraryParenthesesSpacing"/>
		<exclude name="Generic.Formatting.MultipleStatementAlignment"/>
		<exclude name="Generic.ControlStructures.InlineControlStructure"/>
		<exclude name="PEAR.Functions.FunctionCallSignature"/>
		<exclude name="NormalizedArrays.Arrays.ArrayBraceSpacing"/>
		<exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
		<exclude name="Universal.Operators.DisallowShortTernary"/>
		<exclude name="Squiz.Functions.FunctionDeclarationArgumentSpacing"/>
		<exclude name="Squiz.ControlStructures.ControlSignature"/>
		<exclude name="Squiz.Commenting"/>
		<exclude name="WordPress.WhiteSpace"/>
		<exclude name="WordPress.Arrays"/>

		<!-- Style choices that are not correctness issues. -->
		<exclude name="WordPress.PHP.YodaConditions"/>

		<!-- Custom tables: $wpdb usage is intentional and covered by tests. -->
		<exclude name="WordPress.DB.DirectDatabaseQuery"/>

		<!-- Table-name interpolation ({\$wpdb->prefix}...) is standard WP practice
		     for custom tables; values are still prepared. -->
		<exclude name="WordPress.DB.PreparedSQL.InterpolatedNotPrepared"/>
		<exclude name="WordPress.DB.PreparedSQL.NotPrepared"/>
		<exclude name="WordPress.DB.PreparedSQLPlaceholders.UnfinishedPrepare"/>
		<exclude name="WordPress.DB.PreparedSQLPlaceholders.UnsupportedPlaceholder"/>
		<exclude name="WordPress.DB.PreparedSQLPlaceholders.ReplacementsWrongNumber"/>

		<!-- Nonce verification is centralized in handlers (post_nonce_ok, etc.);
		     the per-line sniff cannot follow the indirection. -->
		<exclude name="WordPress.Security.NonceVerification.Missing"/>
		<exclude name="WordPress.Security.NonceVerification.Recommended"/>

		<!-- Templates use esc_* but the sniff misses some dynamic contexts. -->
		<exclude name="WordPress.Security.EscapeOutput.OutputNotEscaped"/>

		<!-- Validated/sanitized input is handled via sanitize_* calls that the
		     sniff does not recognize. -->
		<exclude name="WordPress.Security.ValidatedSanitizedInput.InputNotSanitized"/>
		<exclude name="WordPress.Security.ValidatedSanitizedInput.MissingUnslash"/>
		<exclude name="WordPress.Security.ValidatedSanitizedInput.InputNotValidated"/>

		<!-- date() vs gmdate(): legacy calls, not a correctness issue. -->
		<exclude name="WordPress.DateTime.CurrentTimeTimestamp.Requested"/>

		<!-- meta_query / tax_query are the WordPress query API; flagging them
		     as slow is a smell the plugin cannot act on without abandoning
		     the platform's own querying model. -->
		<exclude name="WordPress.DB.SlowDBQuery"/>

		<!-- Renumbering placeholders (%d -> %1$d) rewrites the msgid, which
		     desynchronises every catalog and silently drops translations at
		     runtime. Placeholder order stays a source-level decision. -->
		<exclude name="WordPress.WP.I18n.UnorderedPlaceholdersText"/>

		<!-- Classes live in class-*.php by project convention. Honouring the
		     WordPress file-naming sniff would mean renaming files and every
		     require_once that points at them. -->
		<exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
	</rule>

	<config name="minimum_wp_version" value="6.4"/>
	<config name="testVersion" value="8.1-"/>
</ruleset>
