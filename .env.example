# Travel Agency Platform — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# === WordPress ===
WP_DEBUG=false
WP_DEBUG_LOG=false

# === Database ===
DB_NAME=travel_agency
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost

# === Onvo Pay (Costa Rica) ===
# Get these from https://onvopay.com/dashboard
ONVO_SECRET_KEY=onvo_test_secret_key_...
ONVO_PUBLISHABLE_KEY=onvo_test_publishable_key_...
# Webhook secret (whsec_...) from Onvo dashboard
ONVO_WEBHOOK_SECRET=whsec_...

# === PayPal (optional, legacy) ===
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_SANDBOX=1