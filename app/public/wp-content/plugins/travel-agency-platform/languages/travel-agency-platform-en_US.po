msgstr "Scarlet macaws in pairs and dry forest flocks"

#: includes/class-destination-spots.php:2464
msgid "Capuchin de cara blanca en los árboles del bosque"
msgstr "White-faced capuchins in the forest trees"

#: includes/class-destination-spots.php:2465
msgid "Puma que recorre el parque de madrugada"
msgstr "Puma roaming the park at dawn"

#: includes/class-destination-spots.php:2466
msgid "Crocodrilos del río Tárcoles en las barras de arena"
msgstr "Crocodiles of the Tárcoles River on the sandbars"

#: includes/class-destination-spots.php:2469
msgid "Caminata hasta el mirador de la Piedra Bola"
msgstr "Walk to the Piedra Bola viewpoint"

#: includes/class-destination-spots.php:2470
msgid "Observación de aves a lo largo del río Tárcoles"
msgstr "Birdwatching along the Tárcoles River"

#: includes/class-destination-spots.php:2471
msgid "Paseo en bote por el estero y los manglares"
msgstr "Boat ride through the estuary and the mangroves"

#: includes/class-destination-spots.php:2472
msgid "Visita a una granja de crocodilos"
msgstr "Visit to a crocodile farm"

