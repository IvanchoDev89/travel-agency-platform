msgstr "Raccoon, green iguana and other mammals"

#: includes/class-destination-spots.php:2175
msgid "Caminata guiada de observación de aves"
msgstr "Guided birdwatching walk"

#: includes/class-destination-spots.php:2176
msgid "Visita al centro de visitantes"
msgstr "Visit to the visitor center"

#: includes/class-destination-spots.php:2177
