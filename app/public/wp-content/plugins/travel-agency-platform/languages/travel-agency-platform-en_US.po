#: includes/class-destination-spots.php:2128
msgid "Capuchin de cara blanca en los árboles"
msgstr "White-faced capuchin in the trees"

#: includes/class-destination-spots.php:2129
msgid "Quetzal resplandeciente en el bosque alto"
msgstr "Resplendent quetzal in the high forest"

#: includes/class-destination-spots.php:2130
