msgstr "Humpback whales and dolphins in season"

#: includes/class-destination-spots.php:2095
msgid "Tortugas verdes que anidan en la arena de Malabrigo"
msgstr "Green turtles nesting on the sand at Malabrigo"

#: includes/class-destination-spots.php:2096
msgid "Aves playeras y garzas en la franja de manglar"
msgstr "Shorebirds and herons in the mangrove strip"

#: includes/class-destination-spots.php:2097
msgid "Bosque seco con quebranta y chapulines"
msgstr "Dry forest with quebranta and grasshoppers"

#: includes/class-destination-spots.php:2100
