msgstr "11,700 hectares"

#: includes/class-destination-spots.php:2483
msgid "Alajuela"
msgstr "Alajuela"

#: includes/class-destination-spots.php:2484
msgid "Bosque seco tropical y manglares del Pacífico central"
msgstr "Tropical dry forest and mangroves of the central Pacific"

#: includes/class-destination-spots.php:2485
