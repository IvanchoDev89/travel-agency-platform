{
    "name": "ivanchodev/travel-agency-platform",
    "description": "Multi-agency travel marketplace for WordPress (plugin, E2E suites and dev tooling).",
    "type": "project",
    "license": "proprietary",
    "autoload": {
        "classmap": [
            "app/public/wp-content/plugins/travel-agency-platform/includes/"
        ]
    },
    "require-dev": {
        "php": ">=8.2.35",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.1",
        "squizlabs/php_codesniffer": "^3.13",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "wp-coding-standards/wpcs": "^3.4"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        },
        "sort-packages": true
    },
    "scripts": {
        "lint": "phpcs --warning-severity=0",
        "lint:fix": "phpcbf",
        "analyse": "phpstan analyse",
        "test": "TAP_TEST_ALLOW_DB_WRITES=1 ./tests/run.sh",
        "i18n": "tools/i18n.sh"
    }
}
