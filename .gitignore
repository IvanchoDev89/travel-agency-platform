# Ignore everything by default
/*

# Local by Flywheel / WordPress artifacts
!.gitignore
!README.md
!docs/
docs/*
!docs/*.md
!app/
app/*
!app/public/
app/public/*
!app/public/wp-content/
app/public/wp-content/*
!app/public/wp-content/plugins/
app/public/wp-content/plugins/*
!app/public/wp-content/plugins/travel-agency-platform/
!app/public/wp-content/themes/
app/public/wp-content/themes/*
!app/public/wp-content/themes/travel-agency-theme/
!tests/
tests/*
!tests/*.php
!tests/run.sh

# Maintenance scripts
!tools/
tools/*
!tools/*.sh
!tools/*.php
!tools/*.xml

# Dev tooling
!Makefile
!composer.json
!composer.lock
!.phpcs.xml.dist
!phpstan.neon.dist
!.github/
.github/*
!.github/workflows/
!.github/workflows/*

# Generated translation template (rebuilt by tools/i18n.sh)
app/public/wp-content/plugins/travel-agency-platform/languages/*.pot
